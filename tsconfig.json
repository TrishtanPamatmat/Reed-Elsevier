{
  "compilerOptions": {
    "moduleResolution": "node",
    "module": "commonjs",
    "target": "es2022",
    "types": [
      "node",
      "@wdio/globals/types",
      "@wdio/mocha-framework",
      "chai"
    ],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "ignoreDeprecations": "6.0"
  },
  "include": ["test/**/*.ts", "wdio.conf.ts"]
}